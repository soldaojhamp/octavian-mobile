<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.ForgotPassActivity">

    <!-- Image Header -->

    <!-- Popup LinearLayout -->
    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logowhitebg___copy" />

    <LinearLayout
        android:id="@+id/popupContainer"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/forgotbg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView9">

        <ImageView
            android:id="@+id/imageView13"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:tint="@color/red"
            app:srcCompat="@drawable/back" />

        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/forgotpassimg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="Enter security code"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Please check your Gmail for a text message with your code. Your code is 6 characters in length."
            android:textAlignment="center"
            android:textColor="#A8A8A8"
            android:textSize="14sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/editText6"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:background="@drawable/forgotinput"
                android:hint="4"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColorHint="#80B2B2B2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/editText5"
                app:layout_constraintStart_toEndOf="@+id/editText3"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/editText5"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:background="@drawable/forgotinput"
                android:hint="5"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColorHint="#80B2B2B2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/editText"
                app:layout_constraintStart_toEndOf="@+id/editText6"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <EditText
                android:id="@+id/editText4"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:background="@drawable/forgotinput"
                android:hint="2"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColorHint="#80B2B2B2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/editText3"
                app:layout_constraintStart_toEndOf="@+id/editText2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <EditText
                android:id="@+id/editText3"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:background="@drawable/forgotinput"
                android:hint="3"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColorHint="#80B2B2B2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/editText6"
                app:layout_constraintStart_toEndOf="@+id/editText4"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <EditText
                android:id="@+id/editText"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:background="@drawable/forgotinput"
                android:hint="6"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColorHint="#80B2B2B2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <EditText
                android:id="@+id/editText2"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:background="@drawable/forgotinput"
                android:hint="1"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColorHint="#80B2B2B2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/editText4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/bsubmitForgotpass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/corners"
            android:fontFamily="@font/poppins"
            android:text="Submit"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Login Button -->

    <!-- Sign Up Section -->

</androidx.constraintlayout.widget.ConstraintLayout>
